# Groq API key — required (Whisper STT + LLM inference)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token — optional (only for local LLM fallback)
# HF_TOKEN=your_hf_token_here

# Allowed CORS origins — optional, comma-separated
# Defaults to http://localhost:5173 and http://localhost:8080
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
