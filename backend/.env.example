# Groq API key — required (Whisper STT + LLM inference)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token — optional (only for local LLM fallback)
# HF_TOKEN=your_hf_token_here



# Code execution provider for Coding/DSA rounds — optional
# Default is the free Wandbox public API (no key needed).
# For a self-hosted Piston instance set both of these:
# CODE_EXEC_PROVIDER=piston
# CODE_EXEC_API_URL=http://localhost:2000/api/v2
# Override the Wandbox endpoint if needed:
# CODE_EXEC_WANDBOX_URL=https://wandbox.org/api
